# CAMPUS MEMORY FastAPI runtime configuration.
# Copy this file to .env and fill in local values. Never commit real credentials.

# PostgreSQL connection string for the FastAPI runtime role.
# Prefer an encrypted connection (sslmode=require or verify-full).
# Use the Supabase direct URI when the host can reach it; otherwise use
# the session-mode pooler URI. Do not use the transaction-mode pooler
# for this persistent FastAPI service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase project URL, for example https://xyzcompany.supabase.co
SUPABASE_URL=

# Browser-safe publishable (anon) key used only to call Auth user verification.
# Do not place the service-role key in this backend environment file.
SUPABASE_PUBLISHABLE_KEY=

# Authentication provider. Supported value: supabase
# Leave empty or set another value to keep protected routes fail-closed.
AUTH_PROVIDER=supabase

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Application environment: local | development | test | production
APP_ENV=local

# Optional conservative pool sizing for a student project.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
